<input type="checkbox" title="Menu" class="menu-toggler" />

    <div class="menu-scrollable" onclick="document.querySelector('.menu-toggler').click()">
        <div class="menu-item-list">
        @if (HasServiceBusSelected)
        {
            <div class="menu-item overview-item">
                <NavLink href="@PageConstants.OverviewPage">Overview</NavLink>
            </div>

            <div class="menu-title">Entities</div>

            <div class="menu-item queue-item">
                <NavLink href="@PageConstants.QueueOverviewPage">Queues</NavLink>
            </div>

            <div class="menu-item topic-item">
                <NavLink href="@PageConstants.SubscriptionOverviewPage">Subscriptions</NavLink>
            </div>

            @if (HasBackgroundServiceEnabled)
            {
                <div class="menu-item background-item">
                    <NavLink href="@PageConstants.JobServicePage">Background jobs</NavLink>
                </div>
            }
        }
    </div>
</div>


