<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Testing" Version="13.3.5" />
        <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1"/>
        <PackageReference Include="bunit" Version="2.7.2"/>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Transitive override for GHSA-9mv3-2cwr-p262. -->
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
        <!-- Transitive override for GHSA-7j59-v9qr-6fq9. -->
        <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Net"/>
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Aspire.Hosting.ApplicationModel"/>
        <Using Include="Aspire.Hosting.Testing"/>
        <Using Include="Xunit"/>
        <Using Include="Droomploeg.DreamOps.Aspire.Tests.Actors"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Droomploeg.DreamOps.Aspire.Tests.AppHost\Droomploeg.DreamOps.Aspire.Tests.AppHost.csproj"/>
        <ProjectReference Include="..\..\src\Droomploeg.DreamOps.Application\Droomploeg.DreamOps.Application.csproj"/>
        <ProjectReference Include="..\..\src\Droomploeg.DreamOps.Infrastructure\Droomploeg.DreamOps.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\src\Droomploeg.DreamOps.Core\Droomploeg.DreamOps.Domain.csproj"/>
        <ProjectReference Include="..\..\src\Droomploeg.DreamOps.WebApp\Droomploeg.DreamOps.WebApp.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
