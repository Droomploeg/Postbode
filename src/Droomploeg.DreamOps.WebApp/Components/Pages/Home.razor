@attribute [Route(PageConstants.HomePage)]
@inject IConnectionService _connectionService
@inject NavigationManager _navigationManager
@inject ProtectedSessionStorage _storage

<AuthorizeView Context="authContext">
    <content>
        <GridControl Items="@_connectionService.Connections" TItem="ServiceBusConnectionInfo">
            <GridHeaderItemControl TItem="ServiceBusConnectionInfo">Name</GridHeaderItemControl>
            <GridValueItemControl TItem="ServiceBusConnectionInfo">
                <span @onclick="() => SetClient(context)">@context.Connection.Name</span>
                @if (IsSelected(context))
                {
                    <span class="current selected-servicebus">Current</span>
                }
            </GridValueItemControl>
        </GridControl>
    </content>
</AuthorizeView>