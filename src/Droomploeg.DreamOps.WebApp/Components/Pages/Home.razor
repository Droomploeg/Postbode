@attribute [Route(PageConstants.HomePage)]
@inject ServiceBusConnectionManager ServiceBusClientManager
@inject NavigationManager NavigationManager

<AuthorizeView Context="authContext">
    <content>
        <GridControl Items="@ServiceBusClientManager.ServiceBusInformationList" TItem="ServiceBusConnection">
            <GridHeaderItemControl TItem="ServiceBusConnection">Name</GridHeaderItemControl>
            <GridValueItemControl TItem="ServiceBusConnection">
                <span @onclick="async () => await SetClient(context)">@context.Name</span>
                @if (IsSelected(context))
                {
                    <span class="current selected-servicebus">Current</span>
                }
            </GridValueItemControl>
        </GridControl>
    </content>
</AuthorizeView>