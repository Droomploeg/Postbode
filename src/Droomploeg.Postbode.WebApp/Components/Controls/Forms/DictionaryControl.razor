<dictionarycontrol >
    <table cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr>
                    <td class="key">@item.Key</td>
                    <td class="value">
                        @if (item.Value is LinkValue linkValue)
                        {
                            <a href="@linkValue.Link.AbsoluteUri" target="_blank" rel="noopener noreferrer">@linkValue.Text</a>
                        }
                        else
                        {
                            @item.Value
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</dictionarycontrol>
