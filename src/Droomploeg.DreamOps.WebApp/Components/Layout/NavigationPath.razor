@inject NavigationManager NavigationManager
@inject IServiceBusInfoContext ServiceBusConnectionContext

<div class="path">
@foreach (var keyValue in _crumblePath)
{
    <NavLink href="@keyValue.Value">@keyValue.Key</NavLink>
    <span class="end">&gt;</span>
}
</div>
<div class="item @_icon">@_currentUrl</div>

