@attribute [Route(PageConstants.HomePage)]
@inject ServiceBusManager ServiceBusClientManager
@inject NavigationManager NavigationManager

<AuthorizeView Context="authContext">
    <content>
        <GridControl Items="@ServiceBusClientManager.ServiceBusInformationList" TItem="ServiceBusInfo">
            <GridHeaderItemControl TItem="ServiceBusInfo">Name</GridHeaderItemControl>
            <GridValueItemControl TItem="ServiceBusInfo">
                <span @onclick="() => SetClient(context)">@context.Name</span>
                @if (IsSelected(context))
                {
                    <span class="current selected-servicebus">Current</span>
                }
            </GridValueItemControl>
        </GridControl>
    </content>
</AuthorizeView>