<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xunit.v3 4.0.0 runs on Microsoft Testing Platform v2; the VSTest bridge it used
             before is gone on the .NET 10 SDK. Run tests through the MTP runner instead. -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.3" />
        <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
        <!-- bunit 2.9.0 brings AngleSharp 1.7.0 (fixes GHSA-pgww-w46g-26qg); explicit override for 1.6.0 removed. -->
        <PackageReference Include="bunit" Version="2.9.0" />
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.11" />
        <!-- MTP replacements for the VSTest-only coverlet.collector and trx logger.
             Coverlet has no MTP equivalent; Microsoft.NET.Test.Sdk and
             xunit.runner.visualstudio are VSTest-only and no longer needed. -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Net" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Aspire.Hosting.ApplicationModel" />
        <Using Include="Aspire.Hosting.Testing" />
        <Using Include="Xunit" />
        <Using Include="Droomploeg.Postbode.Aspire.Tests.Actors" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Droomploeg.Postbode.Aspire.Tests.AppHost\Droomploeg.Postbode.Aspire.Tests.AppHost.csproj" />
        <ProjectReference Include="..\..\src\Droomploeg.Postbode.Application\Droomploeg.Postbode.Application.csproj" />
        <ProjectReference Include="..\..\src\Droomploeg.Postbode.Infrastructure\Droomploeg.Postbode.Infrastructure.csproj" />
        <ProjectReference Include="..\..\src\Droomploeg.Postbode.Core\Droomploeg.Postbode.Domain.csproj" />
        <ProjectReference Include="..\..\src\Droomploeg.Postbode.WebApp\Droomploeg.Postbode.WebApp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
